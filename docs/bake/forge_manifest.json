 "stop_cam_note": "glTF node looks down local -Y, up = local -Z (Blender camera axes after Y-up conversion); use node.quaternion * Rx(-90deg) or lookAt(extras.target_gltf_yup). extras: fov_mm, sensor_mm=36",
 "lightmaps": {
  "manifest": "web/lightmaps/manifest.json",
  "uv": "TEXCOORD_1",
  "resolution": 2048,
  "groups": [
   "DeskLamp",
   "FloorLamp",
   "Fill",
   "Window",
   "Neon",
   "Pictures"
  ],
  "blend": "irradiance = sum_g( decode(lm_g) * intensity_g );  three.js: lightMap = blended RT, lightMapIntensity = PI (BRDF_Lambert divides by PI)",
  "click_to_groups": {
   "CLICK_Switch_Lights": [
    "Fill",
    "Pictures"
   ],
   "CLICK_Lamp_Desk": [
    "DeskLamp"
   ],
   "CLICK_Lamp_Floor": [
    "FloorLamp"
   ],
   "CLICK_Neon_Sign": [
    "Neon"
   ]
  },
  "lit_rule": "every primitive with TEXCOORD_1 gets the blended lightmap",
  "lit_mesh_count": 512,
  "unlit_meshes": [
   "CITY_Backdrop",
   "FloorLampBulb",
   "LampBulb",
   "MonitorRim",
   "Neon_GT1",
   "Neon_GT2",
