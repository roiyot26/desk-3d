   "ShelfLED",
   "Terr_Glass",
   "WinGlass"
  ]
 },
 "env": {
  "file": "env/room_env.ktx2",
  "projection": "equirectangular (Blender eye at (0.35,-0.75,1.20) Z-up; +Y Blender = -Z glTF)",
  "scale": 3.61938,
  "use": "scene.environment / material.envMap for metals+gloss only (diffuse already in lightmaps): envMapIntensity ~ scale * 0.5"
 },
 "tone_mapping": "AgXToneMapping, exposure 1.65 (2^0.72), outputColorSpace sRGB"
}